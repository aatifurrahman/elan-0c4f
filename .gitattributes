# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Scripts and source code
*.sh text eol=lf
*.py text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.patch text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary biometric files, packet traces, and libraries
*.pcap binary
*.pcapng binary
*.pgm binary
*.npz binary
*.zip binary
*.so binary
*.so.* binary
*.tar.gz binary
