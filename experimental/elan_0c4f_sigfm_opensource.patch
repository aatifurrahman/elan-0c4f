+/* Image quality metric: pixel standard deviation for contrast evaluation */
+static gdouble
+elan_0c4f_image_quality (const guint8 *data, gsize size)
+{
+  gdouble sum = 0.0, sum_sq = 0.0, mean;
+
+  if (!data || size == 0)
+    return 0.0;
+
+  for (gsize i = 0; i < size; i++)
+    sum += data[i];
+  mean = sum / (gdouble) size;
+
+  for (gsize i = 0; i < size; i++)
+    {
+      gdouble d = (gdouble) data[i] - mean;
+      sum_sq += d * d;
+    }
+
+  return sqrt (sum_sq / (gdouble) size);
+}
