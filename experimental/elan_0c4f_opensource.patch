@@ -447,7 +484,10 @@ elan_run_cmd (FpiSsm                *ssm,
 
   transfer = fpi_usb_transfer_new (dev);
   transfer->ssm = ssm;
-  transfer->short_is_error = TRUE;
+  if (self->dev_type & (ELAN_0C4F | ELAN_0C58))
+    transfer->short_is_error = FALSE;
+  else
+    transfer->short_is_error = TRUE;
 
   fpi_usb_transfer_fill_bulk_full (transfer,
                                    ELAN_EP_CMD_OUT,
@@ -557,12 +597,33 @@ capture_run_state (FpiSsm *ssm, FpDevice *dev)
           fpi_image_device_report_finger_status (idev, TRUE);
           elan_run_cmd (ssm, dev, &get_image_cmd, ELAN_CMD_TIMEOUT);
         }
-      else if (self->dev_type == ELAN_0C58 && self->last_read &&
