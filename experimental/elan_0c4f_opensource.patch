diff --git a/libfprint/drivers/elan.c b/libfprint/drivers/elan.c
index f9cc52f..5f1f8a6 100644
--- a/libfprint/drivers/elan.c
+++ b/libfprint/drivers/elan.c
@@ -324,6 +324,33 @@ elan_submit_image (FpImageDevice *dev)
 
   G_DEBUG_HERE ();
 
+  if (self->dev_type & ELAN_0C4F)
+    {
+      /* Touch/Press mode: extract the full 96x96 stationary impression */
+      raw_frames = self->frames;
+      assembling_ctx.frame_width = self->frame_width;
+      assembling_ctx.frame_height = self->frame_height;
+      assembling_ctx.image_width = self->frame_width;
+      g_slist_foreach (raw_frames, (GFunc) self->process_frame, &frames);
+
+      if (frames != NULL && frames->data != NULL)
+        {
+          struct fpi_frame *f = (struct fpi_frame *) frames->data;
+          img = fp_image_new (self->frame_width, self->frame_height);
+          memcpy (img->data, f->data, self->frame_width * self->frame_height);
+        }
+      else
+        {
+          fpi_image_device_retry_scan (dev, FP_DEVICE_RETRY_GENERAL);
+          g_slist_free_full (frames, g_free);
+          return;
+        }
+
+      g_slist_free_full (frames, g_free);
+      fpi_image_device_image_captured (dev, img);
+      return;
+    }
+
   raw_frames = g_slist_nth (self->frames, ELAN_SKIP_LAST_FRAMES);
 
   assembling_ctx.frame_width = self->frame_width;
@@ -411,7 +438,17 @@ elan_cmd_read (FpiSsm *ssm, FpDevice *dev)
 
   transfer = fpi_usb_transfer_new (dev);
   transfer->ssm = ssm;
-  transfer->short_is_error = TRUE;
+
+  if (self->dev_type & (ELAN_0C4F | ELAN_0C58))
+    {
+      transfer->short_is_error = FALSE;
+      if (self->cmd->cmd != get_image_cmd.cmd && response_len > 0 && response_len < 64)
+        response_len = 64;
+    }
+  else
+    {
+      transfer->short_is_error = TRUE;
+    }
 
   fpi_usb_transfer_fill_bulk (transfer,
