+      else if ((self->dev_type & (ELAN_0C58 | ELAN_0C4F)) && self->last_read)
         {
-          /* 0x00 - not ready
-           * 0xaf - finger removed or sensor busy (seen on 0x0c58) */
-          fpi_ssm_jump_to_state_delayed (ssm, CAPTURE_WAIT_FINGER, 10);
+          guint8 status = self->last_read[0];
+          int min_frames = (self->dev_type & ELAN_0C4F) ? 1 : ELAN_MIN_FRAMES;
+
+          fp_dbg ("elan [0c4f/0c58] capture status byte: 0x%02x, frames: %d",
+                  status, self->num_frames);
+
+          /*
+           * Intercept packet structures coming from 0c4f:
+           * 0x00: idle / settling
+           * 0xaf: finger lifted / transition
+           * 0xff: sensor uncalibrated / idle
+           * 0x01 / 0x02 / 0x03: intermediate touch state
+           */
+          if (self->num_frames >= min_frames)
+            {
+              /* If enough frames are already collected, complete capture gracefully */
+              fp_dbg ("elan [0c4f] non-0x55 received with %d frames; completing capture",
+                      self->num_frames);
+              fpi_ssm_mark_completed (ssm);
+            }
+          else
+            {
+              /* Gracefully retry instead of throwing a hard protocol error */
+              fpi_ssm_jump_to_state_delayed (ssm, CAPTURE_WAIT_FINGER, 15);
+            }
         }
       else
         {
@@ -578,7 +639,24 @@ capture_run_state (FpiSsm *ssm, FpDevice *dev)
       r = elan_save_img_frame (self);
       if (r < 0)
         {
-          fpi_ssm_mark_failed (ssm, fpi_device_error_new (FP_DEVICE_ERROR_GENERAL));
+          if (self->dev_type & ELAN_0C4F)
+            {
+              fp_dbg ("elan [0c4f] frame skipped/dark, current frames: %d", self->num_frames);
+              if (self->num_frames >= 1)
+                fpi_ssm_mark_completed (ssm);
+              else
+                fpi_ssm_jump_to_state_delayed (ssm, CAPTURE_WAIT_FINGER, 15);
+            }
+          else
+            {
+              fpi_ssm_mark_failed (ssm, fpi_device_error_new (FP_DEVICE_ERROR_GENERAL));
+            }
+        }
+      else if ((self->dev_type & ELAN_0C4F) && self->num_frames >= 2)
+        {
+          /* Touch/Press mode: 2 frames captured during touch is complete */
+          fp_dbg ("elan [0c4f] collected %d frames for touch impression, completing", self->num_frames);
+          fpi_ssm_mark_completed (ssm);
         }
       else if (self->num_frames < ELAN_MAX_FRAMES)
         {
@@ -599,6 +677,7 @@ capture_complete (FpiSsm *ssm, FpDevice *_dev, GError *error)
 {
   FpImageDevice *dev = FP_IMAGE_DEVICE (_dev);
   FpiDeviceElan *self = FPI_DEVICE_ELAN (_dev);
+  int min_frames = (self->dev_type & ELAN_0C4F) ? 1 : ELAN_MIN_FRAMES;
 
   G_DEBUG_HERE ();
 
@@ -607,21 +686,40 @@ capture_complete (FpiSsm *ssm, FpDevice *_dev, GError *error)
       (g_error_matches (error, G_USB_DEVICE_ERROR, G_USB_DEVICE_ERROR_TIMED_OUT) &&
        fpi_ssm_get_cur_state (ssm) == CAPTURE_WAIT_FINGER))
     {
-      if (self->num_frames >= ELAN_MIN_FRAMES)
+      if (self->num_frames >= min_frames)
         {
           elan_submit_image (dev);
         }
       else
         {
           fp_dbg ("swipe too short: want >= %d frames, got %d",
-                  ELAN_MIN_FRAMES, self->num_frames);
+                  min_frames, self->num_frames);
           fpi_image_device_retry_scan (dev, FP_DEVICE_RETRY_TOO_SHORT);
         }
       g_clear_error (&error);
     }
   else
     {
-      fpi_image_device_session_error (dev, error);
+      /* Graceful error interception for 04f3:0c4f */
+      if ((self->dev_type & ELAN_0C4F) && self->num_frames >= min_frames)
+        {
+          fp_dbg ("elan [0c4f] recovering %d collected frames despite error: %s",
+                  self->num_frames, error ? error->message : "none");
+          elan_submit_image (dev);
+          g_clear_error (&error);
+        }
+      else if ((self->dev_type & ELAN_0C4F) &&
+               (g_error_matches (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_PROTO) ||
+                g_error_matches (error, G_USB_DEVICE_ERROR, G_USB_DEVICE_ERROR_IO)))
+        {
+          fp_dbg ("elan [0c4f] suppressing fatal protocol error; issuing retry scan");
+          fpi_image_device_retry_scan (dev, FP_DEVICE_RETRY_GENERAL);
+          g_clear_error (&error);
+        }
+      else
+        {
+          fpi_image_device_session_error (dev, error);
+        }
     }
 
   /* Note: We always stop capturing even if that may not be needed always.
@@ -867,17 +965,27 @@ activate_run_state (FpiSsm *ssm, FpDevice *dev)
           self->frame_height = self->raw_frame_height =
             self->last_read[0];
         }
-      /* Work-around sensors returning the sizes as zero-based index
-       * rather than the number of pixels. */
-      if ((self->frame_width % 2 == 1) &&
-          (self->frame_height % 2 == 1))
+      if (self->frame_width == 0 || self->raw_frame_height == 0)
         {
-          self->frame_width++;
-          self->frame_height++;
-          self->raw_frame_height = self->frame_height;
+          fp_dbg ("Invalid dimensions reported, falling back to 96x96 default");
+          self->frame_width = 96;
+          self->raw_frame_height = 96;
+          self->frame_height = ELAN_MAX_FRAME_HEIGHT;
+        }
+      else
+        {
+          /* Work-around sensors returning the sizes as zero-based index
+           * rather than the number of pixels. */
+          if ((self->frame_width % 2 == 1) &&
+              (self->frame_height % 2 == 1))
+            {
+              self->frame_width++;
+              self->frame_height++;
+              self->raw_frame_height = self->frame_height;
+            }
+          if (!(self->dev_type & ELAN_0C4F) && self->frame_height > ELAN_MAX_FRAME_HEIGHT)
+            self->frame_height = ELAN_MAX_FRAME_HEIGHT;
         }
-      if (self->frame_height > ELAN_MAX_FRAME_HEIGHT)
-        self->frame_height = ELAN_MAX_FRAME_HEIGHT;
       fp_dbg ("sensor dimensions, WxH: %dx%d", self->frame_width,
               self->raw_frame_height);
       fpi_ssm_next_state (ssm);
@@ -944,6 +1052,9 @@ dev_init (FpImageDevice *dev)
       break;
     }
 
+  if (self->dev_type & ELAN_0C4F)
+    fpi_device_set_scan_type (FP_DEVICE (dev), FP_SCAN_TYPE_PRESS);
+
   fpi_image_device_open_complete (dev, NULL);
 }
 
